@@ -45,6 +45,26 @@
 #define kLayerSettingsForceEnable "force_enable"
 #define kLayerSettingsDisablePipelinePreCaching "disable_pipeline_pre_caching"
 
+// UltraTears (macOS): Metal cannot turn primitive restart off, and MoltenVK fails every pipeline asked for that (nothing
+// drawn; a failed pipeline later bound crashes). Every pipeline this layer makes goes through here with it on.
+static VkResult CreateGraphicsPipelinesRestartOn(PFN_vkCreateGraphicsPipelines create, VkDevice device, VkPipelineCache cache,
+                                                 uint32_t count, const VkGraphicsPipelineCreateInfo* infos,
+                                                 const VkAllocationCallbacks* allocator, VkPipeline* pipelines) {
+#ifdef __APPLE__
+    std::vector<VkGraphicsPipelineCreateInfo> copies(infos, infos + count);
+    std::vector<VkPipelineInputAssemblyStateCreateInfo> assembly(count);
+    for (uint32_t i = 0; i < count; ++i) {
+        if (!copies[i].pInputAssemblyState) continue;
+        assembly[i] = *copies[i].pInputAssemblyState;
+        assembly[i].primitiveRestartEnable = VK_TRUE;
+        copies[i].pInputAssemblyState = &assembly[i];
+    }
+    return create(device, cache, count, copies.data(), allocator, pipelines);
+#else
+    return create(device, cache, count, infos, allocator, pipelines);
+#endif
+}
+
 #define SHADER_OBJECT_BINARY_VERSION 1
 
