     if (result == VK_SUCCESS) {
         vtable.DestroyPipeline(deviceData.device, temp_pipeline, nullptr);
     } else {
@@ -1803,7 +1823,7 @@ PartialPipeline CreatePartiallyCompiledPipeline(DeviceData const& deviceData, Vk
 
