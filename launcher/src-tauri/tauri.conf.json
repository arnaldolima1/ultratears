{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UltraTears Launcher",
  "version": "0.1.0",
  "identifier": "dev.ultratears.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UltraTears",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0b100e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
